# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
coverage.xml
.coverage
.coverage.*

# 环境与密钥（CONSTRAINTS：.env 不入库）
.env

# 辩论输出（CLI 模式产物）与本地/E2E 测试库
backend/debate/
backend/debate-dev.db
backend/debate-e2e.db

# Playwright 产物
frontend/test-results/
frontend/playwright-report/

# vitest 本地临时目录（沙箱 TMPDIR 回落）
frontend/.tmp/
backend/.tmp/

# 本地 uvicorn / vite 启动日志
backend/.uvicorn.*.log
backend/.dev*.log
frontend/.vite.out.log
frontend/.vite*.log

# 本地联调临时数据库（FakeLLM 开发档 / 截图核版式用）
backend/debate-shot*.db

# 前端（M5 起）
node_modules/
frontend/dist/

# ZCode 本地工具（技能等，非项目代码）
.zcode/
.workbuddy/

# 构建产物
dist/
build/
debate-e2e.db
# 第三方源码：elenchus 是运行依赖，必须入库（B-2 CI 实测发现未提交）；其余 third_party 保持忽略
third_party/*
!third_party/elenchus/
third_party/elenchus/build/
third_party/elenchus/*.egg-info/
third_party/elenchus/docs/
third_party/elenchus/tests/

# ISS-006: database files and debug leftovers must never be committed
*.db
*.sqlite
*_dbg/
