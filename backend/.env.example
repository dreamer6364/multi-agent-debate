# 复制为 .env 并填入真实值；.env 不入库（CONSTRAINTS §1.1）
OPENAI_API_KEY=sk-xxxxxxxx
# OpenAI 兼容服务地址（智谱 GLM / DeepSeek / Kimi / OpenAI 等，换供应商只改这里）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 辩手用主力模型
MODEL_DEBATER=glm-4.7
# 评委/主席/摘要用廉价模型（ARCH D6 分档）
MODEL_OFFICIAL=glm-4.7-air
# MySQL（M3 起）：mysql+asyncmy://user:pass@host:3306/mad?charset=utf8mb4
MYSQL_URL=mysql+asyncmy://debate:change-me@localhost:3306/mad?charset=utf8mb4
JWT_SECRET=please-generate-a-random-32-plus-char-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# 联网搜索（v1.4.1，可选；不配置则仅用本地证据卡）
# SEARCH_PROVIDER=tavily        # zhipu（需智谱搜索资源包）/ tavily / ddgs / none；缺省自动探测
# TAVILY_API_KEY=tvly-xxxx      # tavily.com 免费注册（1000 次/月）
# DEBATE_ENV=prod: production refuses to start when JWT_SECRET is missing; dev falls back to a random per-start key (ISS-009)
