# ---- LLM (model & reasoning-level agnostic) ----
LLM_PROVIDER=anthropic          # anthropic | openai | google | stub  (stub = no key, canned output)
LLM_MODEL=claude-opus-4-8       # e.g. claude-opus-4-8, gpt-4o, gemini-2.0-flash, or an OpenRouter/Ollama id
LLM_EFFORT=medium               # low | medium | high | xhigh | max  (xhigh/max are Anthropic-only)
FALLACY_SENSITIVITY=balanced    # lenient | balanced | strict  (how aggressively to flag; per-call override on Discord)
RATE_LIMIT_PER_MIN=5            # max analyses per user per minute (<=0 disables)

ANTHROPIC_API_KEY=

# Only if LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=                # blank for OpenAI; e.g. https://openrouter.ai/api/v1  or  http://localhost:11434/v1 for Ollama

# Only if LLM_PROVIDER=google  (Gemini, via Google's OpenAI-compatible endpoint):
GOOGLE_API_KEY=

# ---- Discord ----
DISCORD_BOT_TOKEN=

# ---- Slack (optional) ----
SLACK_BOT_TOKEN=                # xoxb-...
SLACK_APP_TOKEN=                # xapp-...  (Socket Mode)
